# Copy this file to .env and set a unique value before starting n8n.
# Never commit .env. It stores the local credential encryption key.

N8N_IMAGE=n8nio/n8n:latest
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_EDITOR_BASE_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false
GENERIC_TIMEZONE=America/New_York
N8N_ENABLED_MODULES=data-table
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

# Generate a value with:
# powershell -NoProfile -Command "[guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')"
N8N_ENCRYPTION_KEY=

# Local Stage 1 smoke-test routing. Keep real values in .env only.
STAGE1_TEST_EMAIL=
TELEGRAM_MANAGER_CHAT_ID=

# Stage 9 (v2) Airtable demo surface. Keep real values in .env only.
# PAT needs scopes: schema.bases:write, data.records:read, data.records:write
AIRTABLE_PAT=
AIRTABLE_BASE_ID=

# Inbox that receives the demo check-in. Falls back to STAGE1_TEST_EMAIL.
DEMO_RECIPIENT_EMAIL=

# Public HTTPS tunnel for the Telegram Trigger. Changes on every cloudflared run.
# Set WEBHOOK_URL and N8N_EDITOR_BASE_URL to this value, then recreate the container.
TUNNEL_URL=
