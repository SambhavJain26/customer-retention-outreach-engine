{
  "id": "wf2-dashboard",
  "name": "WF2 Dashboard",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "board",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "wf2-board-webhook",
      "name": "Board Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 0],
      "webhookId": "wf2-board-webhook"
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "__LEASES_TABLE_ID__"
        },
        "returnAll": true
      },
      "id": "wf2-read-lease-rows",
      "name": "Read Lease Rows",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [280, 0],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "__OUTREACH_LOG_TABLE_ID__"
        },
        "returnAll": true
      },
      "id": "wf2-read-outreach-log-rows",
      "name": "Read Outreach Log Rows",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [560, 0],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "__CONFIG_TABLE_ID__"
        },
        "returnAll": true
      },
      "id": "wf2-read-config-rows",
      "name": "Read Config Rows",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [840, 0],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "__BUILD_BOARD_HTML_CODE__"
      },
      "id": "wf2-build-board-html",
      "name": "Build Board HTML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 0]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.html }}",
        "options": {
          "responseCode": 200,
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/html; charset=utf-8"
              },
              {
                "name": "Cache-Control",
                "value": "no-store"
              }
            ]
          },
          "enableStreaming": false
        }
      },
      "id": "wf2-return-board-html",
      "name": "Return Board HTML",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [1400, 0]
    }
  ],
  "connections": {
    "Board Webhook": {
      "main": [
        [
          {
            "node": "Read Lease Rows",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Lease Rows": {
      "main": [
        [
          {
            "node": "Read Outreach Log Rows",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Outreach Log Rows": {
      "main": [
        [
          {
            "node": "Read Config Rows",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Config Rows": {
      "main": [
        [
          {
            "node": "Build Board HTML",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Board HTML": {
      "main": [
        [
          {
            "node": "Return Board HTML",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {}
}
