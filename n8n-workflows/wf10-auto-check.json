{
  "id": "wf10-auto-check",
  "name": "WF10 Automatic Reply Polling",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "wf10-poll-timer",
      "name": "Every Minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -260,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\n// WF8 owns all reply logic. This workflow only pokes it on a timer.\nreturn [{\n  json: {\n    method: 'POST',\n    url: 'http://localhost:5678/webhook/v2-check-replies',\n    body: { silent: true },\n  },\n}];\n"
      },
      "id": "build-check-request",
      "name": "Build Check Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -40,
        300
      ]
    },
    {
      "parameters": {
        "method": "={{ $json.method }}",
        "url": "={{ $json.url }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 180000
        }
      },
      "id": "wf10-run-check",
      "name": "Run Reply Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        180,
        300
      ],
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Every Minute": {
      "main": [
        [
          {
            "node": "Build Check Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Check Request": {
      "main": [
        [
          {
            "node": "Run Reply Check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": []
}
