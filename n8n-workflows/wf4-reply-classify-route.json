    {
      "parameters": {
        "resource": "text",
        "operation": "response",
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.model_classify }}"
        },
        "responses": {
          "values": [
            {
              "type": "text",
              "role": "user",
              "content": "={{ $json.prompt }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "instructions": "={{ $json.instructions }}",
          "maxTokens": 800,
          "store": false,
          "textFormat": {
            "textOptions": [
              {
                "type": "json_schema",
                "name": "reply_classification",
                "schema": {
                  "type": "object",
                  "properties": {
                    "intent": {
                      "type": "string",
                      "enum": ["STAYING", "WAVERING", "LEAVING", "GRIEVANCE", "UNCLEAR", "NO_SIGNAL", "OPT_OUT"]
                    },
                    "grievance_present": { "type": "boolean" },
                    "grievance_summary": { "type": "string", "maxLength": 200 },
                    "grievance_category": {
                      "type": "string",
                      "enum": ["NONE", "MAINTENANCE", "NEIGHBOURS", "FEES", "COMMUNICATION", "PROPERTY_CONDITION", "OTHER"]
                    },
                    "urgency": {
                      "type": "string",
                      "enum": ["HIGH", "MEDIUM", "LOW"]
                    },
                    "compliance_flag": {
                      "type": "string",
                      "enum": ["NONE", "ACCOMMODATION_REQUEST", "HABITABILITY", "LEGAL_THREAT", "OPT_OUT", "DISCRIMINATION_CONCERN"]
                    },
                    "suggested_human_action": { "type": "string", "maxLength": 160 },
                    "confidence": {
                      "type": "string",
                      "enum": ["HIGH", "MEDIUM", "LOW"]
                    }
                  },
                  "required": ["intent", "grievance_present", "grievance_summary", "grievance_category", "urgency", "compliance_flag", "suggested_human_action", "confidence"],
                  "additionalProperties": false
                },
                "description": "Classification of one inbound tenant reply. Never includes tenant_id or requires_human.",
                "strict": true
              }
            ]
          }
        }
      },
